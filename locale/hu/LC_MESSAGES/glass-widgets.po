#: widgets/weather-placeholder.js:19
msgid "Refreshing..."
msgstr "Frissítés..."

#: prefs.js:18
msgid "General"
msgstr "Általános"

#: prefs.js:23
msgid "Widgets"
msgstr "Minialkalmazások"

#: prefs.js:27
msgid "Clock widget"
msgstr "Óra"

#: prefs.js:28
msgid "Show a frosted glass clock on the desktop"
msgstr "Homályos üveghatású óra megjelenítése az asztalon"

#: prefs.js:34
msgid "System stats widget"
msgstr "Rendszerstatisztikák"

#: prefs.js:35
msgid "Show RAM and CPU usage on the desktop"
msgstr "RAM- és CPU-használat megjelenítése az asztalon"

#: prefs.js:41
msgid "Weather in clock widget"
msgstr "Időjárás az órában"

#: prefs.js:42
msgid "Show current conditions with the clock"
msgstr "Az aktuális időjárás megjelenítése az órával együtt"

#: prefs.js:52 prefs.js:308
msgid "Hourly weather forecast"
msgstr "Óránkénti időjárás-előrejelzés"

#: prefs.js:53
msgid "Show hourly weather forecasts"
msgstr "Óránkénti időjárás-előrejelzés megjelenítése"

#: prefs.js:312
msgid "Hours to show"
msgstr "Megjelenített órák száma"

#: prefs.js:55
msgid "Weekly weather forecast"
msgstr "Heti időjárás-előrejelzés"

#: prefs.js:56
msgid "Show the seven-day weather forecast"
msgstr "Hétnapos időjárás-előrejelzés megjelenítése"

#: prefs.js:62
msgid "Calendar widget"
msgstr "Naptár"

#: prefs.js:63
msgid "Show the current month calendar on the desktop"
msgstr "Az aktuális hónap naptárának megjelenítése az asztalon"

#: prefs.js:69
msgid "World clock widget"
msgstr "Világóra"

#: prefs.js:70
msgid "Show a multi-timezone analog clock on the desktop"
msgstr "Több időzónás analóg óra megjelenítése az asztalon"

#: prefs.js:86
msgid "World clock timezones"
msgstr "A világóra időzónái"

#: prefs.js:96
msgid ""
"Example: UTC, Africa/Nairobi, Europe/London, Asia/Tokyo, America/Sao_Paulo, "
"America/New_York"
msgstr ""
"Példa: UTC, Africa/Nairobi, Europe/London, Asia/Tokyo, America/Sao_Paulo, "
"America/New_York"

#: prefs.js:115
msgid "World clock hour marks"
msgstr "A világóra órajelölései"

#: prefs.js:116
msgid "World clock second hand"
msgstr "A világóra másodpercmutatója"

#: prefs.js:117
msgid "World clock dial numbers"
msgstr "A világóra számlapszámai"

#: prefs.js:118
msgid "World clock relative time"
msgstr "Időeltérés a világórán"

#: prefs.js:127 prefs.js:132
msgid "Clock Style"
msgstr "Az óra stílusa"

#: prefs.js:136
msgid "Enable clock style override"
msgstr "Az óra egyéni stílusának használata"

#: prefs.js:137
msgid "Use custom clock styling instead of the stylesheet default"
msgstr "Egyéni órastílus használata a stíluslap alapbeállítása helyett"

#: prefs.js:143
msgid "24-hour format"
msgstr "24 órás formátum"

#: prefs.js:144
msgid "Use a 24-hour clock instead of 12-hour"
msgstr "24 órás óra használata 12 órás helyett"

#: prefs.js:150
msgid "Font weight"
msgstr "Betűvastagság"

#: prefs.js:151
msgid "100 (thin) to 900 (black)"
msgstr "100 (vékony) és 900 (nagyon vastag) között"

#: prefs.js:166
msgid "Hour/minute size ratio"
msgstr "Az óra és a perc méretaránya"

#: prefs.js:167
msgid "0.5 = smaller hours, 1.0 = equal size, 1.5 = bigger hours"
msgstr "0,5 = kisebb óra, 1,0 = azonos méret, 1,5 = nagyobb óra"

#: prefs.js:182
msgid "Clock color"
msgstr "Az óra színe"

#: prefs.js:183
msgid "Color used when the clock style override is enabled"
msgstr "Az egyéni órastílus használatakor alkalmazott szín"

#: prefs.js:213
msgid "Weather"
msgstr "Időjárás"

#: prefs.js:219
msgid "Location"
msgstr "Hely"

#: prefs.js:220
msgid ""
"Online name services receive your coordinates. Data: OpenStreetMap "
"contributors (ODbL)."
msgstr ""
"Az online helynévszolgáltatások megkapják a koordinátákat. "
"Adatok: az OpenStreetMap közreműködői (ODbL)."

#: prefs.js:225
msgid "Automatic location"
msgstr "Automatikus helymeghatározás"

#: prefs.js:226
msgid ""
"Detect your location automatically. Falls back to the manual coordinates "
"below when unavailable."
msgstr ""
"A hely automatikus meghatározása. Ha nem érhető el, az alább megadott "
"koordinátákat használja."

#: prefs.js:232
msgid "Local - GWeather"
msgstr "Helyi - GWeather"

#: prefs.js:233
msgid "Nominatim"
msgstr "Nominatim"

#: prefs.js:234
msgid "Photon"
msgstr "Photon"

#: prefs.js:237
msgid "Location name provider"
msgstr "Helynévszolgáltató"

#: prefs.js:238
msgid "Coordinate lookup"
msgstr "Helynév keresése koordináták alapján"

#: prefs.js:245
msgid "Latitude"
msgstr "Földrajzi szélesség"

#: prefs.js:246 prefs.js:261
msgid "Used when automatic location is unavailable"
msgstr "Akkor használatos, ha az automatikus helymeghatározás nem érhető el"

#: prefs.js:260
msgid "Longitude"
msgstr "Földrajzi hosszúság"

#: prefs.js:274
msgid "Temperature"
msgstr "Hőmérséklet"

#: prefs.js:278
msgid "Celsius"
msgstr "Celsius"

#: prefs.js:279
msgid "Fahrenheit"
msgstr "Fahrenheit"

#: prefs.js:282
msgid "Temperature unit"
msgstr "Hőmérsékleti mértékegység"

#: prefs.js:283
msgid "Choose how temperatures are displayed"
msgstr "A hőmérséklet megjelenítési módjának kiválasztása"

#: prefs.js:291
msgid "Position"
msgstr "Elhelyezés"

#: prefs.js:296
msgid "Widget Position"
msgstr "A minialkalmazások elhelyezése"

#: prefs.js:302
msgid "Horizontal position (%)"
msgstr "Vízszintes helyzet (%)"

#: prefs.js:303
msgid "0 = left edge, 100 = right edge"
msgstr "0 = bal szél, 100 = jobb szél"

#: prefs.js:311
msgid "Vertical position (%)"
msgstr "Függőleges helyzet (%)"

#: prefs.js:312
msgid "0 = top edge, 100 = bottom edge"
msgstr "0 = felső szél, 100 = alsó szél"

#: prefs.js:321
msgid "Clock position"
msgstr "Az óra helyzete"

#: prefs.js:322
msgid "Stats position"
msgstr "A rendszerstatisztikák helyzete"

#: prefs.js:323
msgid "Calendar position"
msgstr "A naptár helyzete"

#: prefs.js:324
msgid "World clock position"
msgstr "A világóra helyzete"

#: prefs.js:325
msgid "Hourly forecast position"
msgstr "Az óránkénti előrejelzés helyzete"

#: prefs.js:326
msgid "Weekly forecast position"
msgstr "A heti előrejelzés helyzete"

#: prefs.js:332
msgid "Opacity"
msgstr "Átlátszatlanság"

#: prefs.js:333
msgid "Widget transparency (0 = invisible, 1 = opaque)"
msgstr "A minialkalmazások átlátszósága (0 = láthatatlan, 1 = átlátszatlan)"

#: prefs.js:347
msgid "Effects"
msgstr "Hatások"

#: prefs.js:352
msgid "Visual effects"
msgstr "Vizuális hatások"

#: prefs.js:356
msgid "Blur effect"
msgstr "Elmosás"

#: prefs.js:357
msgid "Apply a frosted glass blur behind the widgets"
msgstr "Homályos üveghatás alkalmazása a minialkalmazások mögött"

#: prefs.js:363
msgid "Glass reflection"
msgstr "Üvegtükröződés"

#: prefs.js:364
msgid "Add a subtle sheen across the top of each widget"
msgstr "Halvány csillogás hozzáadása a minialkalmazások tetejéhez"

#: prefs.js:370
msgid "Reflection style"
msgstr "A tükröződés stílusa"

#: prefs.js:371
msgid "Choose the kind of glass reflection to apply"
msgstr "Az üvegtükröződés típusának kiválasztása"

#: prefs.js:374
msgid "Sheen"
msgstr "Csillogás"

#: prefs.js:375
msgid "Mirror"
msgstr "Tükör"

#: prefs.js:383
msgid "Sponsor"
msgstr "Támogatás"

#: prefs.js:388
msgid "Support Glass Widgets"
msgstr "A Glass Widgets támogatása"

#: prefs.js:400
msgid ""
"Glass-widgets is free, if you'd like to support it, a coffee goes toward "
"keeping it working through GNOME Shell updates."
msgstr ""
"A Glass-widgets ingyenes. Egy kávé árával támogathatja, hogy a GNOME Shell "
"frissítései után is működjön."

#: prefs.js:411
msgid "QR code to buy the developer a coffee"
msgstr "QR-kód egy kávé vásárlásához a fejlesztőnek"

#: prefs.js:415
msgid ""
"Scan to buy me a coffee, it keeps glass-widgets running through GNOME Shell "
"updates."
msgstr ""
"Hívjon meg egy kávéra a kód beolvasásával, hogy a glass-widgets a GNOME Shell "
"frissítései után is működjön."

